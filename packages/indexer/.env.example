# Hedera network the mirror node is read from: testnet | mainnet | previewnet
HEDERA_NETWORK=testnet

# Override the mirror node REST base URL (defaults to the network's public one)
# MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com

# What to index. `yarn passport:bootstrap` writes these into .env.local for you.
# Explicit topic ids take precedence over discovery from the registry's logs.
INDEXER_TOPIC_IDS=
PASSPORT_REGISTRY_ADDRESS=

# Poll interval against the mirror node, in milliseconds
INDEXER_POLL_MS=5000

# Index storage. SQLite needs no setup; set DATABASE_URL to use Postgres instead.
INDEX_DB_PATH=./data/passport.db
# DATABASE_URL=postgres://passport:passport@localhost:5432/passport

# Port for the read-only index API served by `yarn indexer:dev`
INDEXER_PORT=3001

# Gateway the indexer reads documents back through, to check each one against
# the hash its event committed to. Any public or private gateway works; it has
# no bearing on the CID.
IPFS_GATEWAY_URL=https://ipfs.io

# This file is a template. Never put an operator key in the indexer — it only reads.
