{
  "name": "@sh/indexer",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./events": "./src/events/index.ts",
    "./events/canonicalize": "./src/events/canonicalize.ts",
    "./events/metadata": "./src/events/metadata.ts",
    "./content/ipfs": "./src/content/ipfs.ts"
  },
  "bin": {
    "passport-indexer": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "dev": "tsx src/index.ts dev",
    "replay": "tsx src/index.ts replay",
    "verify": "tsx src/index.ts verify",
    "format": "prettier --write './**/*.ts'",
    "lint": "eslint",
    "lint-staged": "eslint",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/eslintrc": "~3.3.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "~22.13.0",
    "@types/pg": "^8.23.1",
    "@typescript-eslint/eslint-plugin": "~8.27.0",
    "@typescript-eslint/parser": "~8.27.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "~9.23.0",
    "eslint-config-prettier": "~10.1.1",
    "eslint-plugin-prettier": "~5.2.4",
    "globals": "~16.0.0",
    "prettier": "^3.5.3",
    "tsx": "~4.19.2",
    "typescript": "^5.8.2",
    "vitest": "~3.0.5"
  },
  "dependencies": {
    "@ipld/car": "^5.4.7",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.2",
    "drizzle-orm": "^0.45.2",
    "ipfs-unixfs-exporter": "^16.2.3",
    "ipfs-unixfs-importer": "^17.1.1",
    "multiformats": "^14.0.5",
    "pg": "^8.23.0"
  }
}
