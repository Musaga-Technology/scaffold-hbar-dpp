{
  "name": "@sh/indexer",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "bin": {
    "passport-indexer": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "dev": "tsx src/index.ts dev",
    "replay": "tsx src/index.ts replay",
    "verify": "tsx src/index.ts verify",
    "format": "prettier --write './**/*.ts'",
    "lint": "eslint",
    "lint-staged": "eslint",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/eslintrc": "~3.3.0",
    "@types/node": "~22.13.0",
    "@typescript-eslint/eslint-plugin": "~8.27.0",
    "@typescript-eslint/parser": "~8.27.0",
    "eslint": "~9.23.0",
    "eslint-config-prettier": "~10.1.1",
    "eslint-plugin-prettier": "~5.2.4",
    "globals": "~16.0.0",
    "prettier": "^3.5.3",
    "tsx": "~4.19.2",
    "typescript": "^5.8.2",
    "vitest": "~3.0.5"
  }
}
