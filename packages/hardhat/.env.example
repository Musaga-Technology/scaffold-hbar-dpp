# Hedera JSON-RPC endpoint (testnet default, change for mainnet)
HEDERA_RPC_URL=https://testnet.hashio.io/api

# Don't fill manually. Run yarn hardhat:account:generate or yarn hardhat:account:import first.
DEPLOYER_PRIVATE_KEY_ENCRYPTED=

# Operator used for Hedera Consensus Service work during `yarn passport:bootstrap`
# (creating the product topic and submitting its events).
#
# Leave both blank and the bootstrap derives the operator from the deployer's own
# ECDSA key, resolving its 0.0.x id through the mirror node. Set them only when the
# operator should differ from the deployer. Must be an ECDSA account for EVM flows.
#
# NEVER commit real values. This file is a template; secrets belong in .env, which
# is gitignored and must stay that way.
HEDERA_OPERATOR_ID=
HEDERA_OPERATOR_PRIVATE_KEY=

# HBAR forwarded as msg.value to cover HTS token creation (default 20).
# Too low and createCollection reverts; the bootstrap prints the exact shortfall.
BOOTSTRAP_COLLECTION_FEE_HBAR=20

# Public base URL baked into the HIP-412 metadata pointer stored on each serial.
NEXT_PUBLIC_APP_URL=http://localhost:3000
