# Copy to .env.local. Nothing here is required: with no .env.local at all the app
# runs on bundled demo data. `yarn passport:bootstrap` writes the registry values
# into .env.local for you and leaves anything else you add there untouched.

# --- Written by the bootstrap. Public values, safe in the browser. -------------
NEXT_PUBLIC_PASSPORT_REGISTRY_ADDRESS=
NEXT_PUBLIC_PASSPORT_TOKEN_ID=
# testnet, mainnet or previewnet. Chooses HashScan links, mirror node reads, and
# the network the operator below writes to — one setting for all three.
NEXT_PUBLIC_HEDERA_NETWORK=testnet

# Where the index API is. The bootstrap sets http://localhost:3001. Unset means
# the app serves its bundled demo passports and says so on every page.
INDEX_API_URL=

# --- Operator: creates topics and submits events for the issuer page. ---------
# Server-side only. Never prefix these with NEXT_PUBLIC_, and never commit real
# values. Without them the issuer page's write routes return 503 with setup
# instructions; verifying passports never needs them.
HEDERA_OPERATOR_ID=
HEDERA_OPERATOR_PRIVATE_KEY=

# --- Document storage. Server-side only. ---------------------------------------
# A free key from pinata.cloud is enough. Without one, the issuer page says up
# front that documents cannot be attached; everything else works.
PINATA_JWT=
# Optional. Only names the provider in diagnostics — never changes a CID, and the
# app's document links go through inbrowser.link regardless.
PINATA_GATEWAY_URL=

# Permanent storage via Arweave, instead of IPFS pinning. Takes precedence over
# PINATA_JWT when both are set. An Arweave JWK as JSON; devnet uploads are free
# and devnet data is pruned after about sixty days. Needs
# `yarn workspace @sh/nextjs add @irys/sdk`, kept optional so teams using IPFS do
# not install an Arweave SDK they will never call.
ARWEAVE_JWK=
ARWEAVE_NETWORK=devnet

# --- Wallet connection, from scaffold-hbar. Optional. --------------------------
# WalletConnect project id from cloud.reown.com; without one, the WalletConnect
# option uses scaffold-hbar's shared development id.
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=
# JSON-RPC overrides. Blank uses Hashio, Hedera's public relay.
NEXT_PUBLIC_HEDERA_MAINNET_RPC_URL=
NEXT_PUBLIC_HEDERA_TESTNET_RPC_URL=
