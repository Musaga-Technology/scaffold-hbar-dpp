NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=
NEXT_PUBLIC_HEDERA_MAINNET_RPC_URL=
NEXT_PUBLIC_HEDERA_TESTNET_RPC_URL=

# Written by `yarn passport:bootstrap` into .env.local — public values only.
NEXT_PUBLIC_PASSPORT_REGISTRY_ADDRESS=
NEXT_PUBLIC_PASSPORT_TOKEN_ID=
NEXT_PUBLIC_HEDERA_NETWORK=testnet

# Base URL used to build the metadata fallback when no storage is configured.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Operator credentials for the server routes that create topics and submit HCS
# messages. Server-side only — never prefix these with NEXT_PUBLIC_, and never
# commit real values.
HEDERA_OPERATOR_ID=
HEDERA_OPERATOR_PRIVATE_KEY=
HEDERA_NETWORK=testnet

# Decentralised storage for passport documents (certificates, test reports).
# Server-side only. A free key from pinata.cloud is enough for testnet.
# Without it the app still runs; attaching a document returns 503 with
# instructions and every other route is unaffected.
PINATA_JWT=
# Optional dedicated gateway. Affects how documents are displayed, never the CID.
PINATA_GATEWAY_URL=
