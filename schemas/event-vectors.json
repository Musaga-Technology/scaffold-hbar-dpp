{
  "$comment": "Shared conformance vectors for the passport event model. Every implementation in this repo asserts against these. Regenerate only when the event schema version changes - editing them invalidates every payload hash already written to a topic.",
  "schemaVersion": 1,
  "canonicalize": [
    {
      "name": "sorts object keys",
      "value": {
        "b": 1,
        "a": 2
      },
      "canonical": "{\"a\":2,\"b\":1}"
    },
    {
      "name": "sorts nested object keys",
      "value": {
        "z": {
          "y": 1,
          "x": 2
        },
        "a": 3
      },
      "canonical": "{\"a\":3,\"z\":{\"x\":2,\"y\":1}}"
    },
    {
      "name": "preserves array order",
      "value": [
        3,
        1,
        2
      ],
      "canonical": "[3,1,2]"
    },
    {
      "name": "sorts keys inside arrays",
      "value": [
        {
          "b": 1,
          "a": 2
        }
      ],
      "canonical": "[{\"a\":2,\"b\":1}]"
    },
    {
      "name": "keeps explicit nulls",
      "value": {
        "a": null
      },
      "canonical": "{\"a\":null}"
    },
    {
      "name": "escapes unicode per JSON",
      "value": {
        "note": "Gdansk \u2014 caf\u00e9"
      },
      "canonical": "{\"note\":\"Gdansk \u2014 caf\u00e9\"}"
    },
    {
      "name": "handles empty object",
      "value": {},
      "canonical": "{}"
    },
    {
      "name": "handles numbers and booleans",
      "value": {
        "n": 1.5,
        "t": true,
        "f": false
      },
      "canonical": "{\"f\":false,\"n\":1.5,\"t\":true}"
    }
  ],
