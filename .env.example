# Configuration for `docker compose up`.
#
# Copy to `.env` and fill in after running `yarn passport:bootstrap`, which
# prints every value below. With this file absent, compose still starts: the
# indexer waits for configuration and the app serves its bundled demo fixtures.
#
# Never commit a filled-in copy. The operator key signs HCS submissions.

# Point the app at the indexer. Leave unset to keep serving demo fixtures.
INDEX_API_URL=http://indexer:3001

# What to index, and what the app should display.
HEDERA_NETWORK=testnet
PASSPORT_REGISTRY_ADDRESS=
PASSPORT_TOKEN_ID=
INDEXER_TOPIC_IDS=

# Server-side only, and only needed to create topics and submit events.
# Leave blank and those routes return 503 with instructions; everything else works.
HEDERA_OPERATOR_ID=
HEDERA_OPERATOR_PRIVATE_KEY=
