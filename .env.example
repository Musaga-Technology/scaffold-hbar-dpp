# Configuration for `docker compose up`.
#
# With no .env at all, compose still starts: the indexer waits for a registry
# and the app serves its bundled demo passports.
#
# To run against your own registry: run `yarn passport:bootstrap` first, then
# copy this file to `.env` and fill it in. Every value is already in
# packages/nextjs/.env.local and packages/indexer/.env.local after the bootstrap.
#
# Never commit a filled-in copy. The operator key signs HCS submissions.

# Point the app at the indexer container. Only once a registry exists; before
# that, leave it unset so the app shows the demo instead of an empty index.
INDEX_API_URL=http://indexer:3001

# What to index and display. Changing HEDERA_NETWORK needs
# `docker compose up --build`, because it is baked into the browser bundle.
HEDERA_NETWORK=testnet
PASSPORT_REGISTRY_ADDRESS=
PASSPORT_TOKEN_ID=
# Leave empty. Set, it replaces discovery from the registry, and products
# registered afterwards are never indexed.
INDEXER_TOPIC_IDS=

# Decentralised storage for passport documents. Server-side only.
# A free key from pinata.cloud is enough; without one, the issuer page says
# documents cannot be attached and everything else works.
PINATA_JWT=
PINATA_GATEWAY_URL=
# Gateways the indexer verifies documents through. None is trusted: each
# document is checked block by block against its CID.
IPFS_GATEWAY_URL=https://trustless-gateway.link,https://gateway.pinata.cloud
ARWEAVE_GATEWAY_URL=https://arweave.net

# Permanent storage instead of IPFS pinning. Takes precedence when both are set.
ARWEAVE_JWK=
ARWEAVE_NETWORK=devnet

# Server-side only, and only needed to create topics and submit events from the
# issuer page. Leave blank and those routes return 503 with instructions.
HEDERA_OPERATOR_ID=
HEDERA_OPERATOR_PRIVATE_KEY=

# Optional WalletConnect project id from cloud.reown.com. Baked into the browser
# bundle, so rebuild after changing it.
WALLET_CONNECT_PROJECT_ID=
